{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "src/app.ts",
    "src/server.ts",
    "src/config/env.ts",
    "src/errors/**/*.ts",
    "src/lib/**/*.ts",
    "src/middleware/**/*.ts",
    "src/modules/**/*.ts",
    "src/scripts/**/*.ts",
    "src/types/express.d.ts"
  ],
  "exclude": ["dist", "node_modules", "tests"]
}
