generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

enum InventoryDocumentType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

enum InventoryDocumentStatus {
  DRAFT
  DONE
  CANCELED
}

enum StockMovementType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.VarChar(320)
  passwordHash       String
  role               UserRole            @default(WAREHOUSE_STAFF)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdDocuments   InventoryDocument[] @relation("DocumentCreatedBy")
  validatedDocuments InventoryDocument[] @relation("DocumentValidatedBy")
  stockMovements     StockMovement[]     @relation("MovementPerformedBy")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(100)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             String                  @id @default(uuid()) @db.Uuid
  name           String                  @db.VarChar(150)
  sku            String                  @unique @db.VarChar(64)
  categoryId     String?                 @db.Uuid
  unitOfMeasure  String                  @db.VarChar(32)
  reorderLevel   Decimal                 @default(0) @db.Decimal(18, 3)
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  category       ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  balances       StockBalance[]
  documentItems  InventoryDocumentItem[]
  stockMovements StockMovement[]

  @@index([name])
  @@index([categoryId])
}

model Warehouse {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(120)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]
}

model Location {
  id                   String              @id @default(uuid()) @db.Uuid
  warehouseId          String              @db.Uuid
  name                 String              @db.VarChar(120)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  balances             StockBalance[]
  sourceDocuments      InventoryDocument[] @relation("DocumentSourceLocation")
  destinationDocuments InventoryDocument[] @relation("DocumentDestinationLocation")
  sourceMovements      StockMovement[]     @relation("MovementSourceLocation")
  destinationMovements StockMovement[]     @relation("MovementDestinationLocation")

  @@unique([warehouseId, name])
  @@index([warehouseId])
}

model StockBalance {
  productId  String   @db.Uuid
  locationId String   @db.Uuid
  quantity   Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([productId, locationId])
  @@index([locationId])
}

model InventoryDocument {
  id                    String                  @id @default(uuid()) @db.Uuid
  type                  InventoryDocumentType
  status                InventoryDocumentStatus @default(DRAFT)
  clientReference       String?                 @db.VarChar(120)
  sourceLocationId      String?                 @db.Uuid
  destinationLocationId String?                 @db.Uuid
  reason                String?                 @db.VarChar(500)
  createdById           String                  @db.Uuid
  validatedById         String?                 @db.Uuid
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  validatedAt           DateTime?
  sourceLocation        Location?               @relation("DocumentSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation   Location?               @relation("DocumentDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  createdBy             User                    @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  validatedBy           User?                   @relation("DocumentValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  items                 InventoryDocumentItem[]
  movements             StockMovement[]

  @@unique([type, clientReference])
  @@index([type, status])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([createdAt])
}

model InventoryDocumentItem {
  id         String            @id @default(uuid()) @db.Uuid
  documentId String            @db.Uuid
  productId  String            @db.Uuid
  quantity   Decimal           @db.Decimal(18, 3)
  document   InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  movement   StockMovement?

  @@unique([documentId, productId])
  @@index([productId])
}

model StockMovement {
  id                    String                @id @default(uuid()) @db.Uuid
  type                  StockMovementType
  productId             String                @db.Uuid
  quantity              Decimal               @db.Decimal(18, 3)
  sourceLocationId      String?               @db.Uuid
  destinationLocationId String?               @db.Uuid
  documentId            String                @db.Uuid
  documentItemId        String                @unique @db.Uuid
  performedById         String                @db.Uuid
  createdAt             DateTime              @default(now())
  product               Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocation        Location?             @relation("MovementSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation   Location?             @relation("MovementDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  document              InventoryDocument     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentItem          InventoryDocumentItem @relation(fields: [documentItemId], references: [id], onDelete: Restrict)
  performedBy           User                  @relation("MovementPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([documentId])
  @@index([type, createdAt])
}
